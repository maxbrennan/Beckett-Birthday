# macOS
.DS_Store

# Environment config (local secrets)
.env

# App config: real trivia answers and win-screen text are spoilers, never commit.
# config/app-config.example.json stays tracked as the template.
config/app-config.json

# Elm
elm-stuff/
elm-client.js
elm-server.js

# Node
node_modules/

# Build output
dist/

# Coverage reports
coverage/
.coverage/

# Auth (server-local user/uuid stores; never commit)
.auth/

# TLS certs (local dev; never commit private keys)
certs/*
!certs/.gitkeep

# Assets (large binaries; distributed separately)
assets/*
!assets/.gitkeep

# Dist orchestrator artifacts
app-uuid.json
app-builds/*
!app-builds/.gitkeep

# Claude Code worktree scratch directories (local only, never commit)
.claude/worktrees/